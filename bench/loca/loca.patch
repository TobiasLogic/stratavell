diff --git a/inference/stratavell_ctx.py b/inference/stratavell_ctx.py
new file mode 100644
index 0000000..91e27a0
--- /dev/null
+++ b/inference/stratavell_ctx.py
@@ -0,0 +1,146 @@
+import json
+import os
+import time
+
+from stratavell import Client, Session
+
+MEMORY_TOOLS = {
+    "memory_search", "memory_expand", "memory_get_event", "memory_get_artifact",
+    "memory_get_task_state", "memory_get_summary_lineage", "memory_stats", "memory_update_task",
+}
+
+PASSIVE_TOOLS = ("memory_search", "memory_get_event", "memory_expand", "memory_get_artifact")
+
+READ_TOOLS = ("read_file", "read_text_file", "read_multiple_files", "read_media_file")
+WRITE_TOOLS = ("write_file", "edit_file", "create_directory", "move_file")
+
+
+def _text(content):
+    if content is None:
+        return ""
+    if isinstance(content, str):
+        return content
+    if isinstance(content, list):
+        out = []
+        for p in content:
+            if isinstance(p, dict) and p.get("type") == "text":
+                out.append(p.get("text", ""))
+            elif isinstance(p, str):
+                out.append(p)
+        return "\n".join(out)
+    return json.dumps(content)
+
+
+def _args(raw):
+    if isinstance(raw, dict):
+        return raw
+    try:
+        v = json.loads(raw or "{}")
+    except (TypeError, ValueError):
+        return {"_unparsed_arguments": str(raw)}
+    return v if isinstance(v, dict) else {"value": v}
+
+
+class StratavellContext:
+    def __init__(self, session_id, window, max_output, url=None, policy=None, recorder=None):
+        self.client = Client(url or os.environ.get("STRATAVELL_URL", "http://127.0.0.1:7077"), timeout=300)
+        pol = {"config_version": 2, "budget": {"context_window": int(window), "max_output_tokens": int(max_output)}}
+        for k, v in (policy or {}).items():
+            if isinstance(v, dict):
+                pol.setdefault(k, {}).update(v)
+            else:
+                pol[k] = v
+        self.client.request("POST", "/v1/sessions", {"id": session_id, "project": "loca-bench", "policy": pol})
+        self.agent = Session(self.client, session_id).agent("main")
+        self.names = {}
+        self.open = []
+        self.recorder = recorder if recorder is not None else []
+
+    def _convert(self, m):
+        role = m.get("role")
+        if role == "assistant":
+            parts = []
+            text = _text(m.get("content"))
+            if text:
+                parts.append({"type": "text", "text": text})
+            for tc in m.get("tool_calls") or []:
+                fn = tc.get("function", {})
+                self.names[tc["id"]] = fn.get("name", "")
+                parts.append({"type": "tool_call", "tool_call_id": tc["id"], "tool_name": fn.get("name", ""), "input": _args(fn.get("arguments"))})
+            if not parts:
+                parts.append({"type": "text", "text": "(no content)"})
+            return {"role": "assistant", "parts": parts}
+        if role == "tool":
+            cid = m.get("tool_call_id", "")
+            name = m.get("name") or self.names.get(cid, "")
+            text = _text(m.get("content"))
+            meta = {}
+            if name.endswith(READ_TOOLS):
+                meta["content_type"] = "file_read"
+            elif name.endswith(WRITE_TOOLS):
+                meta["content_type"] = "file_write"
+            elif "python" in name or "execute" in name or "run_command" in name:
+                meta["content_type"] = "command"
+            elif text[:1] in "[{":
+                meta["content_type"] = "json"
+            out = {"role": "tool", "parts": [{"type": "tool_result", "tool_call_id": cid, "tool_name": name, "text": text}]}
+            if meta:
+                out["meta"] = meta
+            return out
+        return {"role": "user", "parts": [{"type": "text", "text": _text(m.get("content"))}]}
+
+    def _unanswered(self):
+        out = [{"role": "tool", "parts": [{"type": "tool_result", "tool_call_id": cid, "tool_name": self.names.get(cid, ""), "text": "(no result was returned for this call)", "is_error": True}]} for cid in self.open]
+        self.open = []
+        return out
+
+    def append(self, *openai_messages):
+        out = []
+        for m in openai_messages:
+            if not m:
+                continue
+            role = m.get("role")
+            if role == "tool":
+                cid = m.get("tool_call_id", "")
+                if cid not in self.open:
+                    continue
+                self.open.remove(cid)
+            else:
+                out.extend(self._unanswered())
+                if role == "assistant":
+                    self.open = [tc["id"] for tc in m.get("tool_calls") or []]
+            out.append(self._convert(m))
+        if out:
+            self.agent.append(*out)
+
+    def assemble(self, openai_tools, model, max_tokens):
+        if self.open:
+            self.agent.append(*self._unanswered())
+        defs = []
+        for t in openai_tools or []:
+            fn = t.get("function", t)
+            defs.append({"name": fn.get("name"), "description": fn.get("description", ""), "input_schema": fn.get("parameters") or {"type": "object", "properties": {}}})
+        t0 = time.time()
+        out = self.agent.assemble(tools=defs, fmt="openai", model=model, max_tokens=max_tokens, include_memory_tools=True)
+        rep = out.get("report") or {}
+        self.recorder.append({"t": t0, "assemble_ms": round((time.time() - t0) * 1000, 1), "tokens": out.get("tokens"), "capacity": out.get("capacity"), "state": rep.get("state"), "actions": rep.get("actions"), "summary_tokens": rep.get("summary_tokens"), "pinned_tokens": rep.get("pinned_tokens"), "history_tokens": rep.get("history_tokens"), "masked": rep.get("masked"), "previewed": rep.get("previewed"), "wait_ms": rep.get("wait_ms")})
+        req = out["request"]
+        return req.get("messages", []), req.get("tools")
+
+    def passive_tools(self, openai_tools):
+        defs = self.client.request("GET", "/v1/tools")
+        extra = [{"type": "function", "function": {"name": d["name"], "description": d.get("description", ""), "parameters": d.get("input_schema") or {"type": "object", "properties": {}}}} for d in defs if d.get("name") in PASSIVE_TOOLS]
+        return list(openai_tools or []) + extra
+
+    def usage(self, usage):
+        if usage:
+            self.agent.usage({"input_tokens": int(usage.get("prompt_tokens") or 0), "output_tokens": int(usage.get("completion_tokens") or 0)})
+
+    def run_memory_tool(self, tool_call):
+        fn = tool_call.get("function", {})
+        try:
+            res = self.agent.tool(fn.get("name"), _args(fn.get("arguments")))
+            text = res.get("text", "")
+        except Exception as e:
+            text = "memory tool error: " + str(e)[:500]
+        return {"role": "tool", "tool_call_id": tool_call["id"], "content": text}
